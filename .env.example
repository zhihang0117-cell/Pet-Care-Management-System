OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RELATIONAL_COMPANY_ID=1

# One process-lifetime executor is shared by tool calls. Calls return a
# structured timeout to the agent instead of blocking the request forever.
TOOL_EXECUTOR_MAX_WORKERS=4
TOOL_CALL_TIMEOUT_SECONDS=20

# RAG defaults are explicit so a missing environment value cannot silently
# switch the query vector model/provider.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# /chat authentication and local single-instance rate limits
CHAT_API_KEY=replace-with-a-long-random-secret
CHAT_RATE_LIMIT_PER_IP_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_PHONE_PER_MINUTE=30
PAWFECT_DEBUG_MODE=false

# Node -> Python document endpoints
INTERNAL_API_KEY=replace-with-a-separate-long-random-secret

# Real customer delivery. Use `console` only for local UAT.
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
