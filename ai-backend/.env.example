OPENAI_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
ROUTER_CONFIDENCE_THRESHOLD=0.80
FINAL_RESPONSE_PROVIDER=openai
FINAL_RESPONSE_MODEL=gpt-4o-mini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Relational DB layer: mock = local fallback, supabase = live Supabase tables (set in local .env for real DB testing)
DATABASE_PROVIDER=mock
# Relational repository: mock = JSON store, supabase = read-only Supabase (falls back to DATABASE_PROVIDER)
RELATIONAL_PROVIDER=mock
MOCK_STORE_PATH=app/mock_store/state.json
# Company scope for relational queries; defaults to RAG_COMPANY_ID if unset
RELATIONAL_COMPANY_ID=1
RAG_PROVIDER=mock
RAG_TOP_K=5
RAG_RPC=match_chunks_bge_m3
RAG_TABLE=chunks_bge_m3
RAG_COMPANY_ID=1
FINAL_CONTEXT_CHUNKS=2
MAX_FINAL_CONTEXT_CHUNKS=3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
